{
  "additionalProperties": false,
  "description": "组合与执行共用的风险参数；账户身份独立于离线或 Paper 装配模式。",
  "properties": {
    "account_id": {
      "title": "Account Id",
      "type": "string"
    },
    "daily_loss_limit": {
      "default": 0.03,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Daily Loss Limit",
      "type": "number"
    },
    "drawdown_limit": {
      "default": 0.1,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Drawdown Limit",
      "type": "number"
    },
    "fee_per_share": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0.005",
      "title": "Fee Per Share"
    },
    "max_adv_fraction": {
      "default": 0.01,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Max Adv Fraction",
      "type": "number"
    },
    "max_gross": {
      "default": 0.9,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Max Gross",
      "type": "number"
    },
    "max_positions": {
      "default": 20,
      "minimum": 1,
      "title": "Max Positions",
      "type": "integer"
    },
    "max_sector": {
      "default": 0.25,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Max Sector",
      "type": "number"
    },
    "max_single": {
      "default": 0.05,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Max Single",
      "type": "number"
    },
    "max_turnover": {
      "default": 1.0,
      "exclusiveMinimum": 0,
      "maximum": 2,
      "title": "Max Turnover",
      "type": "number"
    },
    "minimum_fee": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "1",
      "title": "Minimum Fee"
    },
    "price_buffer": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0.01",
      "title": "Price Buffer"
    },
    "quote_max_age_seconds": {
      "default": 60,
      "minimum": 0,
      "title": "Quote Max Age Seconds",
      "type": "integer"
    },
    "ranking_buffer": {
      "const": 0,
      "default": 0,
      "title": "Ranking Buffer",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "strategy": {
      "default": "weekly-two-factor",
      "enum": [
        "weekly-two-factor",
        "ma-trend"
      ],
      "title": "Strategy",
      "type": "string"
    },
    "target_weight": {
      "default": 0.045,
      "exclusiveMinimum": 0,
      "maximum": 1,
      "title": "Target Weight",
      "type": "number"
    }
  },
  "required": [
    "account_id"
  ],
  "title": "StrategyConfig",
  "type": "object"
}
