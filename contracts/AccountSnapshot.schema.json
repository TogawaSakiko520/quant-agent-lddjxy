{
  "additionalProperties": false,
  "description": "经适配器确认的账户事实；首版持仓整股、现金美元、禁止空头。",
  "properties": {
    "account_id": {
      "default": "DEMO",
      "title": "Account Id",
      "type": "string"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "available_cash": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Available Cash"
    },
    "cash": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Cash"
    },
    "cost_basis": {
      "additionalProperties": {
        "anyOf": [
          {
            "minimum": 0.0,
            "type": "number"
          },
          {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "type": "string"
          }
        ]
      },
      "title": "Cost Basis",
      "type": "object"
    },
    "fees": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "default": "0",
      "title": "Fees"
    },
    "positions": {
      "additionalProperties": {
        "minimum": 0,
        "type": "integer"
      },
      "title": "Positions",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "as_of",
    "cash",
    "available_cash"
  ],
  "title": "AccountSnapshot",
  "type": "object"
}
