{
  "$defs": {
    "Score": {
      "additionalProperties": false,
      "description": "共同合格股票池的方向一致评分，不解释为预期收益。",
      "properties": {
        "components": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "title": "Components",
          "type": "object"
        },
        "schema_version": {
          "default": "1.1.0",
          "enum": [
            "1.0.0",
            "1.1.0"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "sector": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sector"
        },
        "security_id": {
          "title": "Security Id",
          "type": "string"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "security_id",
        "sector",
        "components",
        "value"
      ],
      "title": "Score",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "策略输出评分列表与排除原因；策略不能直接生成券商副作用。",
  "properties": {
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "title": "Decision Time",
      "type": "string"
    },
    "excluded": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Excluded",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "pattern": "^1\\.0\\.0$",
      "title": "Schema Version",
      "type": "string"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/Score"
      },
      "title": "Scores",
      "type": "array"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "strategy_version": {
      "default": "weekly-two-factor-1.0.0",
      "title": "Strategy Version",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "decision_time",
    "snapshot_id",
    "scores"
  ],
  "title": "SignalSet",
  "type": "object"
}
